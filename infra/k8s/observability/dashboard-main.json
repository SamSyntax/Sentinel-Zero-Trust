{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "panels": [
    {
      "title": "Data Plane: mTLS Failures",
      "transparent": true,
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-proxy\"} | json | level=\"ERROR\" | msg=~\"failed to establish outbound mTLS|TLS handshake failed.*|no client certificate provided|inbound connection is not TLS.*\" [$__range])) or vector(0)",
          "legendFormat": "mTLS failures",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Control Plane: Certificate Issuance",
      "transparent": true,
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-control-plane\"} | json | message=~\"Certificate issued successfully.*\" [$__range])) or vector(0)",
          "legendFormat": "Cert Issued",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-control-plane\"} | json | message=~\"Certificate issuance failed.*\" [$__range])) or vector(0)",
          "legendFormat": "Issue Failed",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Rotation Latency (P95, 15m)",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "id": 3,
      "fieldConfig": {
        "defaults": { "unit": "ns" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "quantile_over_time(0.95, {container=\"sentinel-proxy\"} | json | msg=\"certificate rotated successfully\" | unwrap duration [15m]) by (service)",
          "legendFormat": "{{service}} P95",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Hardware: CPU Usage (Millicores)",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 0, "y": 4 },
      "id": 5,
      "fieldConfig": {
        "defaults": { "unit": "mcore" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(irate(container_cpu_usage_seconds_total{container=~\"sentinel-.*\"}[5m])) by (container) * 1000",
          "legendFormat": "{{container}} CPU",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Hardware: Memory Usage (Working Set)",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 4 },
      "id": 6,
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(container_memory_working_set_bytes{container=~\"sentinel-.*\"}) by (container)",
          "legendFormat": "{{container}} RAM",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Certificate Rotation Health",
      "transparent": true,
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "id": 7,
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-proxy\"} | json | msg=\"certificate rotated successfully\" [$__range])) by (service)",
          "legendFormat": "{{service}} rotated",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-proxy\"} | json | msg=\"certificate rotation failed, will retry\" [$__range])) by (service)",
          "legendFormat": "{{service}} retry/fail",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Live Log Stream",
      "transparent": true,
      "type": "logs",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 9 },
      "id": 4,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{container=~\"sentinel-control-plane|sentinel-proxy\"} | json",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["sentinel-zt", "kubernetes", "infrastructure"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Service Mesh Health",
  "uid": "sentinel-zt-prod"
}
