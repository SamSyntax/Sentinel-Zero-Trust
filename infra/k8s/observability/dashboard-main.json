{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "panels": [
    {
      "title": "Data Plane: mTLS Error Rate",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-proxy\"} | json | level=\"ERROR\" [5m]))",
          "legendFormat": "Errors (Proxy)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Control Plane: Vault Status",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({instance=\"control-plane\"} | json | regexp \"eventType=(?P<extracted_event>[^, ]+)\" | extracted_event = \"CERTIFICATE_ISSUED\" [5m]))",
          "legendFormat": "Cert Issued",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "sum(count_over_time({container=\"sentinel-control-plane\"} | json | level=\"ERROR\" [1m]))",
          "legendFormat": "Vault Fail",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Rotation Latency (P99)",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "fieldConfig": {
        "defaults": { "unit": "ns" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "max(quantile_over_time(0.99, {container=\"sentinel-proxy\"} | json | msg=\"certificate rotated successfully\" | unwrap duration [1m])) by (container)",
          "legendFormat": "P99 Latency",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Hardware: CPU Usage (Millicores)",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "fieldConfig": {
        "defaults": { "unit": "mcore" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(irate(container_cpu_usage_seconds_total{container=~\"sentinel-.*\"}[5m])) by (container) * 1000",
          "legendFormat": "{{container}} CPU",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Hardware: Memory Usage (Working Set)",
      "transparent": true,
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(container_memory_working_set_bytes{container=~\"sentinel-.*\"}) by (container)",
          "legendFormat": "{{container}} RAM",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Live Log Stream",
      "transparent": true,
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 15 },
      "id": 4,
      "options": {
        "showTime": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "expr": "{container=~\"sentinel-control-plane|sentinel-proxy\"} | json",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 42,
  "tags": ["sentinel-zt", "kubernetes", "infrastructure"],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "Service Mesh Health",
  "uid": "sentinel-zt-prod"
}
